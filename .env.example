# 複製成 .env 後填入自己的值（.env 不會被 git 追蹤）

# --- X（Twitter）貼文來源 -------------------------------------------------
X_USERNAME=qq_timmy
# api = 官方 X API v2（需要 Basic 以上方案，免費方案不能讀推文）
# rss = 自架 RSSHub / Nitter 之類的鏡像
X_SOURCE=api
X_BEARER_TOKEN=
# X_SOURCE=rss 時才需要，例如 https://rsshub.example.com/twitter/user/qq_timmy
X_RSS_URL=
# 第一次執行時往回抓幾小時
LOOKBACK_HOURS=24
MAX_POSTS_PER_RUN=25

# --- Claude 分析 ----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low / medium / high / xhigh / max
ANTHROPIC_EFFORT=high
# 開啟網路搜尋可讓「市場如何看待」更貼近近況，但會增加 token 成本
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=5

# --- Telegram 推播 --------------------------------------------------------
# telegram（預設）/ line / stdout（只印在終端機，測試用）
NOTIFIER=telegram
# 跟 Telegram 的 @BotFather 送 /newbot 申請，格式像 123456789:AAH...
TELEGRAM_BOT_TOKEN=
# 數字 chat id，不是 @使用者名稱；執行 python scripts/telegram_get_chat_id.py 取得
TELEGRAM_CHAT_ID=

# --- LINE 推播（備用，台灣帳號可能受區域限制而無法使用）---------------------
LINE_CHANNEL_ACCESS_TOKEN=
# 要填 U 開頭的 userId，不是 LINE ID
LINE_TO_USER_ID=
# 只有跑 scripts/line_get_user_id.py 驗簽章時才需要
LINE_CHANNEL_SECRET=

# --- 其他 -----------------------------------------------------------------
# 台股名錄快取幾小時後重抓
REGISTRY_TTL_HOURS=24
HTTP_TIMEOUT=30
